# ============================================================
# CivicAction Environment Configuration
# ============================================================

# Database Backend: 'sqlite' (local default) or 'supabase'
DB_BACKEND=sqlite

# ------------------------------------------------------------
# Supabase Configuration
# Required only if DB_BACKEND=supabase
# ------------------------------------------------------------
# 1. Project URL (Found under Project Settings > API in your Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Project API Key (anon public key or service_role key)
SUPABASE_KEY=your-supabase-api-key-here

# 3. Direct PostgreSQL Connection URI (Optional: for direct psycopg/SQL migrations)
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
